# Copy to .env in this directory. Never commit the real file.
OPENROUTER_API_KEY=
PAYLANE_MODEL=deepseek/deepseek-v4.1-flash
PAYLANE_JUDGE_MODEL=qwen/qwen3-235b-a22b-2507
# Private local database. CLI/evaluation use synthetic data only.
PAYLANE_DATA_DIR=.runtime
# Optional hosted live demo: set a strong invite secret; empty means loopback only.
PAYLANE_DEMO_INVITE=

# Operator kill switch; rechecked by the atomic refund mutation.
PAYLANE_REFUNDS_ENABLED=true
